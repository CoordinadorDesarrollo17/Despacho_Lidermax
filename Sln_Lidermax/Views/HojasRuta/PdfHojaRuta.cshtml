@model List<ReporteHojaRutaDto>

@{
    Layout = "~/Views/Shared/_LayoutReporte.cshtml";
    int totalCajas = Model.Sum(x => x.Cajas);
}

<style>

    table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        font-size: 10px;
    }


    th, td {
        border: 1px solid #000;
        padding: 3px;
        vertical-align: top;
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
    }

    th {
        text-align: center;
        font-weight: bold;
    }



    /* Para impresión */
    @@media print {
        table

    {
        page-break-inside: auto;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    thead {
        display: table-header-group;
    }

    }
</style>
<style>
    .contenedor-firmas {
        width: 100%;
        margin-top: 80px;
    }

    .firmas {
        width: 100%;
        border-collapse: collapse;
        margin-top: 40px;
        margin-bottom: 80px;
    }

        .firmas td {
            border: none;
            text-align: center;
            font-size: 11px;
        }

    .linea-firma {
        border-top: 1px solid #000;
        width: 260px;
        margin: 0 auto 6px auto;
    }

    @@media print {
        .contenedor-firmas

    {
        page-break-inside: avoid;
    }

    }
</style>
<table>
    <thead>
        <tr>
            <th style="vertical-align: middle;" colspan="2">
                <img src="~/img/logo-drogueria-cobefar.jpg" style="width:170px;height:60px;" />
            </th>
            <th style="vertical-align: middle;" colspan="6">
                FORMATO PROVINCIA
            </th>
            <th style="vertical-align: middle;" colspan="5">
                Proveedor Transporte: LIDERMAX PERU S.A.C<br />
                Nro: @ViewBag.DocNum
            </th>
            <th style="vertical-align: middle;" colspan="4">
                FECHA: @ViewBag.TiempoPac
            </th>
        </tr>
        <tr>
            <th >Ticket</th>
            <th >RazonSocial</th>
            <th >Departamento1</th>
            <th >Provincia1</th>
            <th >Distrito1</th>
            <th >Departamento2</th>
            <th >Provincia2</th>
            <th >Distrito2</th>
            <th>Vendedor</th>
            <th >Direccion1</th>
            <th >Direccion2</th>
            <th>Transportista</th>
            <th>ModoEnvio</th>
            <th >Cajas</th>
            <th style="width:50px">Peso</th>
            <th >Vista</th>
            <th >ALM</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td >@d.DocNumTicket</td>
                <td >@d.CardName</td>

                <td>@d.Departamento1</td>
                <td>@d.Provincia1</td>
                <td>@d.Distrito1</td>

                <td>@d.Departamento2</td>
                <td>@d.Provincia2</td>
                <td>@d.Distrito2</td>

                <td>@d.Vendedor</td>

                <td>
                    @d.Calle1 - @d.Distrito1 - @d.Provincia1 - @d.Departamento1
                </td>

                <td>
                    @d.Calle2 - @d.Distrito2 - @d.Provincia2 - @d.Departamento2
                </td>

                <td>@d.Transportista</td>
                <td >@d.ModoEnvio</td>
                <td>@d.Cajas</td>
                <td >@d.Peso kg</td>
                <td ></td>
                <td >@d.Almacen</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="13" style="font-size: 18px;text-align:right">
                Total Cajas:
            </th>
            <th colspan="4" style="font-size: 18px;" >@totalCajas</th>
        </tr>
    </tfoot>
</table>
<div class="contenedor-firmas">
    <table class="firmas">
        <tr>
            <td>
                <div class="linea-firma"></div>
                <strong>TRANSPORTISTA</strong>
            </td>

            <td>
                <div class="linea-firma"></div>
                <strong>VIGILANCIA</strong>
            </td>
        </tr>
    </table>
</div>
``