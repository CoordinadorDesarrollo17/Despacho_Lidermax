@model List<ReporteHojaRutaModel>

@{
    Layout = "~/Views/Shared/_LayoutReporte.cshtml";
    int totalCajas = Model.Sum(x => x.Cajas);
    bool tieneDetalle = Model.Any(x => x.TipoRuta =="VD");
}

<style>

    table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        font-size: 10px;
    }


    th, td {
        border: 1px solid #000;
        padding: 3px;
        vertical-align: top;
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
    }

    th {
        text-align: center;
        font-weight: bold;
    }



    /* Para impresión */
    @@media print {
        table

    {
        page-break-inside: auto;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    thead {
        display: table-header-group;
    }

    }
</style>
<style>
    .contenedor-firmas {
        width: 100%;
        margin-top: 80px;
    }

    .firmas {
        width: 100%;
        border-collapse: collapse;
        margin-top: 40px;
        margin-bottom: 80px;
    }

        .firmas td {
            border: none;
            text-align: center;
            font-size: 11px;
        }

    .linea-firma {
        border-top: 1px solid #000;
        width: 260px;
        margin: 0 auto 6px auto;
    }

    @@media print {
        .contenedor-firmas

    {
        page-break-inside: avoid;
    }

    }
</style>
<table>
    <thead>
        <tr style="font-size: 16px;">
            <th style="vertical-align: middle;" colspan="2">
                <img src="~/img/logoLidermax2.jpeg" style="width:170px;height:60px;" />
            </th>
            <th style="vertical-align: middle;" colspan="3">
                DATOS CONTACTO
            </th>
            <th style="vertical-align: middle;" colspan="4">
                Proveedor Transporte: LIDERMAX PERU S.A.C<br />
                Nro: @ViewBag.DocNum<br />
                @if (!string.IsNullOrWhiteSpace(ViewBag.Placa?.ToString()))
                {
                    <text>Placa: @ViewBag.Placa</text>
                }
            </th>
            <th style="vertical-align: middle;" colspan="3">
                FECHA: @ViewBag.TiempoPac<br />
                HORA: @ViewBag.HoraPac
            </th>
        </tr>
        <tr>
            <th >Ticket</th>
            <th >RazonSocial</th>
            <th >Contacto</th>
            <th >Nro Documento</th>   
            <th>Telefono</th>
            <th>Transportista</th>

            @if (tieneDetalle)
            {
                <th colspan="2">Detalle Pedido</th>
            }
            else
            {
                <th>Direccion1</th>
                <th>Direccion2</th>
            }

            <th>ModoEnvio</th>
            <th >Cajas</th>
            <th style="width:50px">Peso</th>
            <th >Costo</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td >@d.DocNumTicket</td>
                <td >@d.CardName</td>
                <td>@d.NombrePer</td>
                <td>@d.DocPer</td>
                <td>@d.TelfPer</td>
                <td>@d.Transportista</td>

                @if (d.TipoRuta == "VD")
                {
                    <td colspan="2">@d.DetallePedido</td>
                }
                else
                {
                    <td>@d.Direccion1</td>
                    <td>@d.Direccion2</td>
                }


                <td>@d.ModoEnvio</td>
                <td >@d.Cajas</td>
                <td >@d.Peso kg</td>
                <td ></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="9" style="font-size: 18px;text-align:right">
                Total Cajas:
            </th>
            <th colspan="3" style="font-size: 18px;" >@totalCajas</th>
        </tr>
    </tfoot>
</table>
<div class="contenedor-firmas">
    <table class="firmas">
        <tr>
            <td>
                <div class="linea-firma"></div>
                <strong>TRANSPORTISTA</strong>
            </td>

            <td>
                <div class="linea-firma"></div>
                <strong>VIGILANCIA</strong>
            </td>
        </tr>
    </table>
</div>
``