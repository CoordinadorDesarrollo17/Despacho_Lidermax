@using Sln_Lidermax.Models
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<TicketsCoordinados>


<div class="table-responsive">
    <table class="table table-hover align-middle text-nowrap">
        <thead class="table-header">
            <tr>
                <th>Hoja Ruta</th>
                <th>Nro Ticket</th>
                <th>Fecha Documento</th>
                <th>Razon Social</th>
                <th>Placa</th>
                <th>Conductor</th> 
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td data-label="HojaRuta">@u?.DocNumHojaRuta</td>
                    <td data-label="DocNum">@u?.DocNumTicket</td>
                    <td data-label="FechaDocumento">@u?.FechaDocumento?.ToString("dd/MM/yyyy")</td>
                    <td data-label="Socio">@u?.Socio</td>
                    <td data-label="Placa">@u?.Placa</td>
                    <td data-label="Conductor">@u?.Conductor</td>
                   
                    <td data-label="Acciones" class="text-center sticky-actions-td">
                        <div class="actions">
                            <button type="button"
                                    class="btn btn-sm btn-info btn-detalle"
                                    data-docnum="@(u.DocNumTicket)"
                                    data-detallepedido="@(u.DetallePedido ?? "")"
                                    data-entregapedido="@(u.EntregaPedido ?? "")"
                                    data-rangohorario="@(u.RangoHorario ?? "")"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalDetalle">
                                <i class="bi bi-chat-left-text"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-warning btn-editar"   
                                    data-placa="@(u.Placa ?? "")"
                                    data-conductor="@(u.Conductor ?? "")"
                                    data-docentryhojaruta="@u.DocEntryHojaRuta"
                                    data-linea="@u.Linea"
                                    data-docentryticket="@u.DocEntryTicket"   
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalPlacaYConductor"
                                    @(u?.Estado == "ENTREGADO" || u?.Estado == "DEVOLUCION" ? "disabled" : "") >
                                <i class="bi bi-pencil"></i>
                            </button>

                        </div>
                    </td>
               
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-2 gap-2">

    <small class="text-muted text-center text-md-start text-md-nowrap flex-shrink-0">
        Mostrando @Model.FirstItemOnPage a @Model.LastItemOnPage de @Model.TotalItemCount registros
    </small>

    <div class="w-100 w-md-auto paginacion">
        @Html.PagedListPager(Model, page => "javascript:cargarTabla(" + page + ")",
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination", "mb-0" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5
        })
    </div>
</div>
