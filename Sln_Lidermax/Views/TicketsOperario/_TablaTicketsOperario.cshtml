@using Sln_Lidermax.Models
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<TicketsModel>


<div class="table-responsive">
    <table class="table table-hover align-middle text-nowrap">
        <thead class="table-header">
            <tr>
                <th>Ruc</th>
                <th>Socio</th>
                <th>Guias</th>
                <th>OrdenCompra</th>
                <th>Cajas</th>
                <th>Transportista</th>
                <th class="text-center sticky-actions-th">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td data-label="Ruc">@u?.CardCode</td>
                    <td data-label="Socio">@u?.CardName</td>
                    <td data-label="Guias">@u?.GuiaRemision</td>
                    <td data-label="OrdenCompra">@u?.DocNumTicket</td>
                    <td data-label="Cajas">@u?.Cajas</td>
                    <td data-label="Transportista">@u?.Agencia</td>
                   
                    <td data-label="Acciones" class="text-center sticky-actions-td">
                        <div class="actions">

                            <button class="btn btn-sm btn-primary btn-Transportista"
                                    data-docentryticket="@u.DocEntryTicket"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalTransportista"
                                    title="Actualizar transportista"
                                    @(u?.Estado == "DEVOLUCION" || u?.Estado == "ENTREGADO" ? "disabled" : "")>
                                <i class="bi bi-file-earmark-text"></i>
                            </button>
                            <button class="btn btn-sm btn-warning btn-imagen"
                                    data-docentryticket="@u.DocEntryTicket"
                                    data-docnumticket="@u.DocNumTicket"
                                    data-docentryhojaruta="@u.DocEntryHojaRuta"
                                    data-linea="@u.Linea"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalImagen"
                                    title="Registrar imagenes"
                                    @(u?.Estado == "DEVOLUCION" || u?.Estado == "ENTREGADO" ? "disabled" : "")>
                                <i class="bi bi-image"></i>
                            </button>
                            <button class="btn btn-sm btn-success btn-pago"
                                    data-docentryticket="@u.DocEntryTicket"
                                    data-docnumticket="@u.DocNumTicket"
                                    data-docentryhojaruta="@u.DocEntryHojaRuta"
                                    data-estadopago="@u.EstadoPago"
                                    data-linea="@u.Linea"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalPago"
                                    title="Registrar imagen de pago"
                                    @(u?.Estado == "DEVOLUCION" || u?.Estado == "ENTREGADO" ? "disabled" : "")>
                                <i class="bi bi-image"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-dark btn-entregar"
                                    data-docentryticket="@u.DocEntryTicket"
                                    data-docentryhojaruta="@u.DocEntryHojaRuta"
                                    data-linea="@u.Linea"
                                    @(u?.Estado != "ENVIADO" ? "disabled" : "")>
                                <i class="bi bi-check-circle"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-2 gap-2">

    <small class="text-muted text-center text-md-start text-md-nowrap flex-shrink-0">
        Mostrando @Model.FirstItemOnPage a @Model.LastItemOnPage de @Model.TotalItemCount registros
    </small>

    <div class="w-100 w-md-auto paginacion">
        @Html.PagedListPager(Model, page => "javascript:cargarTabla(" + page + ")",
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination", "mb-0" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5
        })
    </div>
</div>
