@using Sln_Lidermax.Models
@using X.PagedList
@model IPagedList<TicketsModel>


@{
    ViewData["Title"] = "Listado de Tickets Recogidos";
}
<div class="card shadow-sm mb-4">
    <div class="card-header header-gradient text-white d-flex justify-content-between align-items-center">

        <h5 class="mb-0 fw-bold">
            TICKETS RECOGIDOS
        </h5>

    
    </div>

    <div class="card-body">
        <div class="card mb-3 border">
            <div class="card-header bg-light fw-semibold">
                Filtros
            </div>
            <div class="card-body">
                <div class="row gy-2">
                    <div class="col-12 col-md-2">
                        <label class="form-label">Fecha entrega</label>
                        <input type="date" id="filtroFechaEntrega" class="form-control form-control-sm">
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label">Fecha Recojo</label>
                        <input type="date" id="filtroFechaRecojo" class="form-control form-control-sm">
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label">Estado</label>
                        <select id="filtroEstado" class="form-select form-select-sm">
                            <option value="">Seleccione</option>
                            <option value="RECOGIDO">RECOGIDO</option>
                            <option value="ENVIADO">ENVIADO</option>
                            <option value="ENTREGADO">ENTREGADO</option>
                            <option value="DEVOLUCION">DEVOLUCION</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label">N° Hoja de ruta</label>
                        <input type="text" id="filtroHojaRuta" class="form-control form-control-sm" autocomplete="off">
                    </div>
                </div>
            </div>
        </div>
    
        <div class="row mb-3 gy-2">
            <div class="col-12 col-md-6">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label class="mb-0 fw-semibold">Mostrar</label>
                    <select id="pageSize" class="form-select form-select-sm w-auto">
                        @foreach (var size in new[] { 1,5, 10, 20, 40, 60, 80, 100 })
                        {
                            <option value="@size" selected="@(size == 10)">@size</option>
                        }
                    </select>
                    <span class="text-nowrap">registros por página</span>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="d-flex justify-content-start justify-content-md-end gap-2">
                    <input type="text"
                           id="txtBuscar"
                           class="form-control form-control-sm w-100 w-md-auto"
                           style="max-width: 300px;"
                           placeholder="Buscar:" autocomplete="off" />
                    <button id="btnExportarExcel" class="btn btn-success btn-sm">
                        <i class="bi bi-file-earmark-excel"></i>
                    </button>
                </div>
            </div>

        </div>

      
        <div id="tablaTicketsRecogidos">
            <partial name="_TablaTicketsRecogidos" model="Model" />
        </div>


    </div>
</div>

<div class="modal fade" id="modalObservacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Observación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <textarea class="form-control"
                          id="observacion"
                          rows="4"
                          maxlength="1000"
                          placeholder="Escribe la observación aquí..."
                          autocomplete="off"></textarea>
            </div>
            <div class="modal-footer">            
                <button type="button" class="btn btn-info" id="btnRegistrarObservacion">Registrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalGuiaTransportista" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Guia Transportista</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control" id="guiaTransportista" autocomplete="off"/>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnRegistrarGuiaTransportista">Registrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEntrega" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Fecha Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="datetime-local" class="form-control" id="fechaEntrega" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnRegistrarFechaEntrega">Registrar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalDevolucion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Fecha de Devolucion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="datetime-local" class="form-control" id="fechaDevolucion" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnRegistrarFechaDevolucion">Registrar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalFecha" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Fecha Despacho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="datetime-local" class="form-control" id="fechaDespacho" />             
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnRegistrarFechaDespacho">Registrar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalImagen" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Imágenes del Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- CONTENEDOR DE IMÁGENES EXISTENTES -->
                <div class="row mb-3" id="contenedorImagenesModal">
                    <!-- Aquí se cargan imágenes dinámicamente -->
                </div>

                <hr />

                <!-- SUBIR NUEVAS IMÁGENES -->
                <h6>Subir nuevas imágenes</h6>
                <div class="mb-2">
                    <label class="form-label">Imagen 1: Comprobante de pago</label>
                    <input type="file" class="form-control" id="img1" accept="image/*" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Imagen 2: Pedido</label>
                    <input type="file" class="form-control" id="img2" accept="image/*" />
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnRegistrarImagen">Registrar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
    
        const txtBuscar = document.getElementById("txtBuscar");
        const cboPageSize = document.getElementById("pageSize");
        const tablaTicketsRecogidos = document.getElementById("tablaTicketsRecogidos");

         const filtroFechaEntrega = document.getElementById("filtroFechaEntrega");
        const filtroFechaRecojo = document.getElementById("filtroFechaRecojo");
        const filtroEstado = document.getElementById("filtroEstado");
        const filtroHojaRuta = document.getElementById("filtroHojaRuta");

          //Nuevo codigo para no perder filtros
         let filtros = {
             buscar: "",
             pageSize: 10,
             fechaEntrega: "",
             fechaRecojo: "",
             estado: "",
             hojaRuta: "",
             paginaActual: 1
         };

         function actualizarFiltros() {
             filtros.buscar = txtBuscar.value;
             filtros.pageSize = cboPageSize.value;
              filtros.fechaEntrega = filtroFechaEntrega.value;
             filtros.fechaRecojo = filtroFechaRecojo.value;
             filtros.estado = filtroEstado.value;
             filtros.hojaRuta = filtroHojaRuta.value;
         }
         // hasta aqui


        //let paginaActual = 1;

        function cargarTabla(page = 1) { //numero de pagina por default

              //paginaActual = page;

            filtros.paginaActual = page;
           actualizarFiltros();

             const params = new URLSearchParams({ //parametros
                 "Buscar": filtros.buscar,
                  "Paginacion.Page": filtros.paginaActual,
                 "Paginacion.PageSize": filtros.pageSize,
                  "FechaEntrega": filtros.fechaEntrega,
                 "FechaRecojo" : filtros.fechaRecojo ,
                 "Estado": filtros.estado,
                 "DocNumHojaRuta": filtros.hojaRuta
                     
                   // "Buscar": txtBuscar.value,
                   // "Paginacion.Page": page,
                   // "Paginacion.PageSize": cboPageSize.value,
                   // "FechaDespacho": filtroFechaDespacho.value,
                   // "Estado": filtroEstado.value,
                   // "DocNumHojaRuta" : filtroHojaRuta.value
             });

            let url = `@Url.Action("ListadoTicketsRecogidos")?${params.toString()}`; //accion del controlador , pasamos parametros

            fetch(url, { //fetch que lanza la accion
                headers:  {
                    "X-Requested-With": "XMLHttpRequest" //nos dice si es una peticion AJAX
                  }
                })
                .then(r => r.text())
                .then(html => {
                tablaTicketsRecogidos.innerHTML = html;


            });

        }
        //lanzamos eventos de los <select>
        cboPageSize.addEventListener("change", () => cargarTabla(1));
         filtroFechaEntrega.addEventListener("change", () => cargarTabla(1));
        filtroFechaRecojo.addEventListener("change", () => cargarTabla(1));
        filtroEstado.addEventListener("change", () => cargarTabla(1));

        //Agregamos evento para que el usuario de enter
        agregarEventosBusqueda(txtBuscar);
          agregarEventosBusqueda(filtroHojaRuta);

          //funcion para agregar evento enter
        function agregarEventosBusqueda(input) {
            if (!input) return;

            // Cuando presiona Enter
            input.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    cargarTabla(1);
                }
            });

            // Cuando borra todo el contenido
            input.addEventListener("input", function () {
                if (input.value.trim() === "") {
                    cargarTabla(1);
                }
            });
        }


        //MODALES
        document.addEventListener("DOMContentLoaded", function() {
            // Modal imágenes
            document.querySelectorAll(".btn-imagen").forEach(btn => {
                btn.addEventListener("click", function() {
                    document.getElementById("img1").value = "";
                    document.getElementById("img2").value = "";
                });
            });

        });

         let docEntryTicketSeleccionado = 0;
         let docNumTicketSeleccionado = 0;
         let docEntryHojaRutaSeleccionado = 0;
         let lineaSeleccionado=0;
        // Cuando se abre el modal
          $(document).on("click", ".btn-guiaTransportista", function () { 
            docEntryHojaRutaSeleccionado = $(this).data("docentryhojaruta");
            lineaSeleccionado = $(this).data("linea");
            docEntryTicketSeleccionado = $(this).data("docentryticket");
        });
        $(document).on("click", ".btn-fecha", function () {
            docEntryHojaRutaSeleccionado = $(this).data("docentryhojaruta");
            lineaSeleccionado = $(this).data("linea");
            docEntryTicketSeleccionado = $(this).data("docentryticket");
        });
        $(document).on("click", ".btn-imagen", function () {
            docNumTicketSeleccionado = $(this).data("docnumticket");
            docEntryTicketSeleccionado = $(this).data("docentryticket");
            docEntryHojaRutaSeleccionado = $(this).data("docentryhojaruta");
            lineaSeleccionado= $(this).data("linea");

            cargarImagenesModal(docNumTicketSeleccionado);
        });

        $(document).on("click", ".btn-entregar", function () {
             docEntryTicketSeleccionado = $(this).data("docentryticket");
             docEntryHojaRutaSeleccionado = $(this).data("docentryhojaruta");
             lineaSeleccionado= $(this).data("linea");
        });

        $(document).on("click", ".btn-anular", function () {
             docEntryTicketSeleccionado = $(this).data("docentryticket");
             docEntryHojaRutaSeleccionado = $(this).data("docentryhojaruta");
             lineaSeleccionado= $(this).data("linea");
        });

         $(document).on("click", ".btn-observacion", function () {
              docEntryTicketSeleccionado = $(this).data("docentryticket");
              docEntryHojaRutaSeleccionado = $(this).data("docentryhojaruta");
              lineaSeleccionado= $(this).data("linea");

              let observacion = $(this).data("observacion");
               $("#observacion").val(observacion ? observacion : "");
         });

        
        // Registrar fecha despacho
         $("#btnRegistrarFechaDespacho").click(function () {
            let fecha = $("#fechaDespacho").val();
            if (!fecha) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Fecha requerida',
                    text: 'Seleccione una fecha de despacho'
                });
                return;
            }
            $.ajax({
                url: '/Tickets/ActualizarFechaDespacho',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    docEntryTicket: docEntryTicketSeleccionado,
                    docEntryHojaRuta: docEntryHojaRutaSeleccionado,
                    linea: lineaSeleccionado,
                    fechaDespacho: fecha              
                }),
                beforeSend: function () {
                    Swal.fire({
                        title: 'Guardando...',
                        text: 'Registrando fecha de despacho',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Registrado',
                            text: 'Fecha registrada correctamente',
                            confirmButtonText: 'OK'
                        }).then(() => {
                                 $('#modalFecha').modal('hide');
                                 $("#fechaDespacho").val("");
                                cargarTabla(filtros.paginaActual);
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo registrar la fecha'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error del servidor',
                        text: 'Ocurrió un problema al procesar la solicitud'
                    });
                }
            });
        });

        ///registrar imagenes
        $("#btnRegistrarImagen").click(function () {

            let img1 = $("#img1")[0].files[0];
            let img2 = $("#img2")[0].files[0];

            if (!img1 || !img2) {
                Swal.fire({
                    icon: "warning",
                    title: "Imágenes requeridas",
                    text: "Debe seleccionar ambas imágenes"
                });
                return;
            }

            let formData = new FormData();
            formData.append("DocEntryTicket", docEntryTicketSeleccionado);
            formData.append("Img1", img1);
            formData.append("Img2", img2);
            formData.append("DocNumTicket",docNumTicketSeleccionado);
            formData.append("DocEntryHojaRuta",docEntryHojaRutaSeleccionado);
            formData.append("Linea",lineaSeleccionado);

            $.ajax({
                url: '/Tickets/SubirImagenes',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,

                beforeSend: function () {
                    Swal.fire({
                        title: "Subiendo imágenes...",
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Imágenes registradas",
                            text: "El ticket fue marcado como ENVIADO"
                        }).then(() => {
                           
                              // cargarImagenesModal(docNumTicketSeleccionado);
                              // $("#img1").val("");
                              // $("#img2").val("");

                                 $('#modalImagen').modal('hide');
                                 $("#img1").val("");
                                 $("#img2").val("");
                                cargarTabla(filtros.paginaActual);

                        });
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: resp.message || "No se pudieron guardar las imágenes"
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Error del servidor"
                    });
                }
            });
        });

        //CARGAR IMAGENES
       function cargarImagenesModal(docNum) {
            const contenedor = document.getElementById("contenedorImagenesModal");
            contenedor.innerHTML = `
                <div class="text-center w-100">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando imágenes...</p>
                </div>
            `;

            fetch(`/Tickets/ObtenerImagenes?docNum=${docNum}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success || data.images.length === 0) {
                        contenedor.innerHTML = `
                            <div class="text-muted text-center w-100">
                                No hay imágenes disponibles
                            </div>
                        `;
                        return;
                    }

                    contenedor.innerHTML = "";
                    data.images.forEach(img => {
                        // contenedor.innerHTML += `
                        //     <div class="col-md-6 text-center mb-3">
                        //         <div class="fw-semibold mb-2">${img.tipo}</div>
                        //           <img src="${img.imagen}" class="img-fluid border rounded shadow-sm w-100" style="max-height:500px;">
                        //     </div>
                        // `;
                          contenedor.innerHTML += `
                                     <div class="col-md-6 mb-4">
                                         <div class="card shadow-sm border-0 h-100">
                                             <div class="card-header bg-light fw-bold text-center">
                                                 ${img.tipo}
                                             </div>
                                             <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                                 <img src="${img.imagen}" class="img-fluid rounded border" style="max-height:500px; object-fit:contain;">
                                             </div>
                                         </div>
                                     </div>
                                 `;
                    });
                })
                .catch(() => {
                    contenedor.innerHTML = `
                        <div class="text-danger text-center w-100">
                            Error al cargar imágenes
                        </div>
                    `;
                });
        }


        document.getElementById("btnExportarExcel").addEventListener("click", function () {
            const query = txtBuscar.value;
                 const url = `@Url.Action("ExportarExcelTicketsHojaRuta", "Tickets")?Buscar=${encodeURIComponent(query)}&esHojaRuta=false&FechaEntrega=${filtroFechaEntrega.value}&Estado=${filtroEstado.value}&DocNumHojaRuta=${filtroHojaRuta.value}&FechaRecojo=${filtroFechaRecojo.value}`;
            window.location.href = url;
        });


        // Registrar guia transportista
        $("#btnRegistrarGuiaTransportista").click(function () {
            let guia = $("#guiaTransportista").val();
            if (!guia) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Guia transportista requerida',
                    text: 'Ingrese un valor'
                });
                return;
            }
            $.ajax({
                url: '/Tickets/ActualizarGuiaTransportista',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    docEntryTicket: docEntryTicketSeleccionado,
                    docEntryHojaRuta: docEntryHojaRutaSeleccionado,
                    linea: lineaSeleccionado,
                    guiaTransportista: guia
                }),
                beforeSend: function () {
                    Swal.fire({
                        title: 'Guardando...',
                        text: 'Registrando guia transportista',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Registrado',
                            text: 'Guia transportista registrada correctamente',
                            confirmButtonText: 'OK'
                        }).then(() => {
                                   $('#modalGuiaTransportista').modal('hide');
                                     $("#guiaTransportista").val("");
                                    cargarTabla(filtros.paginaActual);
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo registrar la guia transportista'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error del servidor',
                        text: 'Ocurrió un problema al procesar la solicitud'
                    });
                }
            });
        });


        ///cambiar estado a ENTREGADO
        $("#btnRegistrarFechaEntrega").click(function () {

            let fecha = $("#fechaEntrega").val();

            if (!fecha) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Fecha requerida',
                    text: 'Seleccione la fecha de entrega'
                });
                return;
            }

            $.ajax({
                url: '/Tickets/EntregarTicket',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    docEntryTicket: docEntryTicketSeleccionado,
                    docEntryHojaRuta: docEntryHojaRutaSeleccionado,
                    linea : lineaSeleccionado,
                    fecha: fecha //  IMPORTANTE 
                }),
                beforeSend: function () {
                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Registrando entrega',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });
                },
                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Entregado correctamente'
                        }).then(() => {

                             $('#modalEntrega').modal('hide');
                             $("#fechaEntrega").val("");
                            cargarTabla(filtros.paginaActual);
                        
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: resp.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error del servidor'
                    });
                }
            });
        });

          /// cambiar estado a DEVOLUCION
         $("#btnRegistrarFechaDevolucion").click(function () {

             let fecha = $("#fechaDevolucion").val();

             if (!fecha) {
                 Swal.fire({
                     icon: 'warning',
                     title: 'Fecha requerida',
                     text: 'Seleccione la fecha de devolución'
                 });
                 return;
             }

             $.ajax({
                 url: '/Tickets/DevolverTicket',
                 type: 'POST',
                 contentType: 'application/json',
                 data: JSON.stringify({
                     docEntryTicket: docEntryTicketSeleccionado,
                     docEntryHojaRuta: docEntryHojaRutaSeleccionado,
                     linea : lineaSeleccionado,
                     fecha: fecha //  IMPORTANTE
                 }),
                 beforeSend: function () {
                     Swal.fire({
                         title: 'Procesando...',
                         text: 'Registrando devolución',
                         allowOutsideClick: false,
                         didOpen: () => Swal.showLoading()
                     });
                 },
                 success: function (resp) {
                     if (resp.success) {
                         Swal.fire({
                             icon: 'success',
                             title: 'Devuelto correctamente'
                         }).then(() => {
                            $('#modalDevolucion').modal('hide');
                           $("#fechaDevolucion").val("");
                           cargarTabla(filtros.paginaActual);
                         });
                     } else {
                         Swal.fire({
                             icon: 'error',
                             title: 'Error'
                         });
                     }
                 },
                 error: function () {
                     Swal.fire({
                         icon: 'error',
                         title: 'Error del servidor'
                     });
                 }
             });
         });




        // Registrar observacion
           $("#btnRegistrarObservacion").click(function () {
             let observacion = $("#observacion").val().trim();
              if (!observacion) {
                 Swal.fire({
                     icon: 'warning',
                     title: 'Observación requerida',
                     text: 'Ingrese un valor'
                 });
                 return;
             }
             $.ajax({
                 url: '/Tickets/ActualizarObservacion',
                 type: 'POST',
                 contentType: 'application/json',
                 data: JSON.stringify({
                     docEntryTicket: docEntryTicketSeleccionado,
                     docEntryHojaRuta: docEntryHojaRutaSeleccionado,
                     linea: lineaSeleccionado,
                     observacion: observacion
                 }),
                 beforeSend: function () {
                     Swal.fire({
                         title: 'Guardando...',
                         text: 'Registrando observacion',
                         allowOutsideClick: false,
                         didOpen: () => {
                             Swal.showLoading();
                         }
                     });
                 },
                 success: function (resp) {
                     if (resp.success) {
                         Swal.fire({
                             icon: 'success',
                             title: 'Registrado',
                             text: 'Observacion registrada correctamente',
                             confirmButtonText: 'OK'
                         }).then(() => {
                             $('#modalObservacion').modal('hide');
                             $("#observacion").val("");
                             cargarTabla(filtros.paginaActual);
                         });
                     } else {
                         Swal.fire({
                             icon: 'error',
                             title: 'Error',
                             text: 'No se pudo registrar la observacion'
                         });
                     }
                 },
                 error: function () {
                     Swal.fire({
                         icon: 'error',
                         title: 'Error del servidor',
                         text: 'Ocurrió un problema al procesar la solicitud'
                     });
                 }
             });
         });

         //Excluir ticket
     $(document).on('click', '.btn-excluir', function () {

            const docEntryTicket = $(this).data('docentryticket');
            const docEntryHojaRuta = $(this).data('docentryhojaruta');
            const linea = $(this).data('linea');

            Swal.fire({
                title: '¿Excluir ticket?',
                text: `Se quitará de la hoja de ruta`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, excluir',
                cancelButtonText: 'Cancelar'
            }).then((result) => {

                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/Tickets/ExcluirTicket',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        docEntryTicket: docEntryTicket,
                        docEntryHojaRuta: docEntryHojaRuta,
                        linea: linea,
                        excluido: true
                    }),
                    beforeSend: function () {
                        Swal.fire({
                            title: 'Procesando...',
                            text: 'Excluyendo ticket',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                    },
                    success: function (resp) {
                        if (resp.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Excluido',
                                text: 'El ticket fue excluido correctamente'
                            }).then(() => {
                                cargarTabla(filtros.paginaActual); // recarga tu tabla
                            });

                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'No se pudo excluir el ticket'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error del servidor',
                            text: 'Ocurrió un problema al procesar la solicitud'
                        });
                    }
                });

            });
        });

    </script>
}